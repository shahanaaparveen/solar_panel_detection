MONGO_URI=mongodb://localhost:27017
DB_NAME=solar_inspect
UPLOAD_DIR=uploads
MAX_UPLOAD_BYTES=52428800
MAX_UPLOAD_FILES=20
AUTH_ENABLED=false
# Production: set AUTH_ENABLED=true and use the trusted OIDC provider values below.
AUTH_ISSUER=
AUTH_AUDIENCE=
AUTH_JWKS_URL=
AUTH_ALLOWED_ALGORITHMS=RS256
AUTH_PROJECTS_CLAIM=project_ids
AUTH_ADMIN_CLAIM=roles
AUTH_ADMIN_VALUE=solar-inspect-admin
AUTH_CLOCK_SKEW_SECONDS=30
MODEL_DEVICE=auto
PANEL_MODEL_PATH=models/panel_detection.pt
THERMAL_MODEL_PATH=models/thermal_defects.pt
RGB_MODEL_PATH=models/rgb_defects.pt
# Optional per-role values:
# PANEL_IMAGE_SIZE=1024
# THERMAL_CONFIDENCE=0.25
# RGB_IOU=0.5
